# Example only. The real .env is generated by ./start.sh and is git-ignored.
# Client secrets are shown by CSS exactly once and cannot be read back; if you
# lose .env, regenerate everything with ./start.sh --reset.

ISSUER=http://localhost:3000
ISSUER_A=http://localhost:3000
ISSUER_B=http://localhost:3001
WEBID_HOST=http://localhost:3002

# Alice -- the data subject, on provider A
ALICE_ISSUER=http://localhost:3000
ALICE_EMAIL=alice@example.org
ALICE_PASSWORD=alice-lab-password
ALICE_POD=http://localhost:3000/alice/
ALICE_WEBID=http://localhost:3000/alice/profile/card#me
ALICE_CLIENT_ID=<generated>
ALICE_CLIENT_SECRET=<generated>

# Bob -- the recipient of shared data, on provider A
BOB_ISSUER=http://localhost:3000
BOB_EMAIL=bob@example.org
BOB_PASSWORD=bob-lab-password
BOB_POD=http://localhost:3000/bob/
BOB_WEBID=http://localhost:3000/bob/profile/card#me
BOB_CLIENT_ID=<generated>
BOB_CLIENT_SECRET=<generated>

# Alice2 -- Alice's account at provider B, destination for the migration
ALICE2_ISSUER=http://localhost:3001
ALICE2_EMAIL=alice2@example.org
ALICE2_PASSWORD=alice2-lab-password
ALICE2_POD=http://localhost:3001/alice2/
ALICE2_WEBID=http://localhost:3001/alice2/profile/card#me
ALICE2_CLIENT_ID=<generated>
ALICE2_CLIENT_SECRET=<generated>
